<div class="modal-container">
    <div class="modal">
        <h2 class="modal-title">{{title}}</h2>
        <div class="modal-body">
            {{> @partial-block }}
        </div>
        <div class="modal-footer">
            {{> Button text=labelOk type="submit" }}
            {{#if labelCancel}}
                {{> Button text=labelCancel isSecondary="true" }}
            {{/if}}
        </div>
    </div>
</div>
